<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/card"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="4dp" android:paddingBottom="4dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/total" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Connect account" android:textSize="15sp" android:textStyle="bold" android:textColor="#EFF5EE"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/req" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textSize="10sp" android:textColor="#ADBBB2" android:maxLines="1" android:ellipsize="end"
        android:layout_marginStart="4dp" android:gravity="center_vertical" />
    <ProgressBar android:id="@+id/request_bar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="40dp" android:layout_height="6dp" android:progressTint="#FFBA7A"
        android:progressBackgroundTint="#39483E" android:layout_marginStart="6dp" android:visibility="gone" />
    <TextView android:id="@+id/refresh" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center"
        android:text="↻" android:textSize="18sp" android:textColor="#FFBA7A" android:contentDescription="Refresh usage" />
</LinearLayout>
