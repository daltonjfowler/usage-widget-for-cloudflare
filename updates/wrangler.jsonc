{
  // The Usage Widget update host. A static-assets Worker that serves latest.json and
  // the signed APK from ./public. No bindings beyond the assets binding, no
  // observability. The tiny Worker script exists only to stamp Cache-Control:
  // no-store on latest.json so a phone always sees the current version; the APK
  // itself is content-addressed by its SHA-256 in latest.json, so it may cache.
  //
  // Deployed by scripts/publish.ps1 (from the repo root) to
  // https://usagewidget-updates.daltonjfowler.workers.dev. This file is written,
  // never deployed, by the worker session; Dalton runs publish.ps1 himself.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "usagewidget-updates",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only latest.json goes through the Worker (to set no-store); everything else
    // (the APK) is served straight from the asset store.
    "run_worker_first": ["/latest.json"]
  },
  "observability": {
    "enabled": false
  }
}
